<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed for the DeepSeek API calls made by the web app itself.
         All UI files are bundled inside the APK and never fetched remotely. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Voice input: the page calls getUserMedia({audio: true}); the app asks at
         runtime the first time the page requests it. WebView's audio capture
         also requires MODIFY_AUDIO_SETTINGS, otherwise Chromium reports
         "Unable to select audio device" even when RECORD_AUDIO is granted. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChatDemo"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
